# =============================================================
# Laravel Cloud — Environment Variables
# Copy these into the Laravel Cloud dashboard (Environment tab)
# Values marked [FILL] must be provided; others have safe defaults
# =============================================================

APP_NAME=Vaelthorn
APP_ENV=production
APP_KEY=[FILL — run: php artisan key:generate --show]
APP_DEBUG=false
APP_URL=[FILL — e.g. https://vaelthorn.laravel.cloud]

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database (Laravel Cloud managed MySQL) ---
DB_CONNECTION=mysql
DB_HOST=[FILL — from Laravel Cloud DB panel]
DB_PORT=3306
DB_DATABASE=[FILL]
DB_USERNAME=[FILL]
DB_PASSWORD=[FILL]

# --- Session / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=vaelthorn_session

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- File Storage (Cloudflare R2) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=[FILL — R2 API token access key ID]
AWS_SECRET_ACCESS_KEY=[FILL — R2 API token secret access key]
AWS_BUCKET=fls-a2581fc2-eef1-4800-81eb-00037456d873
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=https://367be3a2035528943240074d0096e0cd.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=[FILL — public URL of your R2 bucket, e.g. custom domain or r2.dev URL]

# --- Notifications ---
DISCORD_WEBHOOK_URL=[FILL — optional]

# --- Mail (configure if needed) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@vaelthorn.laravel.cloud
MAIL_FROM_NAME=Vaelthorn

VITE_APP_NAME=Vaelthorn
